{
  "name": "alu-logo-registry",
  "version": "1.0.0",
  "description": "Registers the official ALU logo on Ethereum as an ERC-721 NFT and tokenises its ownership as ERC-20 shares (ALUT).",
  "private": true,
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "node": "hardhat node",
    "hash": "node scripts/hash-logo.js",
    "deploy:local": "hardhat run scripts/deploy.js --network localhost",
    "deploy:hardhat": "hardhat run scripts/deploy.js"
  },
  "license": "MIT",
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^6.1.2",
    "hardhat": "^2.29.1"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.6.1"
  }
}
